# ---- Waitlist persistence (server-only; never prefixed with NEXT_PUBLIC_) ----
# Option A: Supabase. Create the table with supabase/waitlist.sql, then set:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_WAITLIST_TABLE=waitlist

# Option B: a JSON-lines file on a server with a persistent disk.
# Used automatically outside production; in production it must be enabled explicitly.
# WAITLIST_STORE=file
# WAITLIST_FILE=data/waitlist.jsonl

# ---- Public site configuration ----
# Canonical URL used for Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Working brand name (pending naming clearance). Leave unset for "Thera".
# NEXT_PUBLIC_BRAND_NAME=Thera
# When set, the footer "Contact" link becomes a mailto: link.
# NEXT_PUBLIC_CONTACT_EMAIL=
